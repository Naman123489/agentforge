# Copy to .env (never commit .env).

# --- Local DGX Spark models ($0 per token): see docs/DGX_SPARK_SETUP.md
# AF_ROUTER_CONFIG=config/profiles/spark-lightning.toml   # or spark-super / spark-mixed
# SPARK_HOST=localhost                                   # Spark IP, or localhost with an SSH tunnel

# --- Nebius Token Factory (submission): lighter Nemotron models, paid from credits
# AF_ROUTER_CONFIG=config/profiles/web-light.toml
# AF_CREDIT_BALANCE_USD=29.50          # hard cap; spend persists in data/ledger.json
NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1   # [VERIFY] regional URL

# Model slots (override config/models.toml without code changes)
# AF_MODEL_A=nvidia/...        # premium reasoning
# AF_MODEL_B=nvidia/...        # main coding
# AF_MODEL_C=nvidia/...        # economy
# AF_MODEL_A_ENABLED=false     # e.g. if Ultra is not in your catalog

# Prices in USD per 1M tokens. Only set values you have confirmed.
# AF_MODEL_A_PRICE_IN=
# AF_MODEL_A_PRICE_OUT=
# AF_MODEL_C_BILLING=free_allowance   # only with a confirmed allowance:
# AF_MODEL_C_FREE_TOKENS=

# Budgets
# AF_RUN_TOKEN_LIMIT=2000000
# AF_RUN_COST_LIMIT_USD=5
# AF_PREMIUM_COST_LIMIT_USD=2
# AF_PREMIUM_TOKEN_LIMIT=400000
# AF_CREDIT_BALANCE_USD=        # hackathon credit balance, enables the "credits under 30%" guard

# ---- Deploy agent (optional, OFF by default; docs/DEPLOY_AGENT.md) ----
# Both are required before any run or API call can publish. Keep the token server-side only.
# AF_DEPLOY_ENABLED=1
# GITHUB_TOKEN=            # fine-grained token: Administration + Contents read/write on the target repos
