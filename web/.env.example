# AgentForge dashboard configuration. Only public, non-secret values belong here: everything
# prefixed VITE_ is compiled into the browser bundle. NEVER put provider keys (NEBIUS_API_KEY) here.

# Base URL of the AgentForge Control Plane API (contract: /api/v1). In dev, /api is proxied by Vite.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev proxy forwards /api (the orchestrator/API server). Not shipped to the browser.
AGENTFORGE_API_PROXY=http://localhost:8000
# The platform bearer token is entered at runtime in Settings (kept in this browser tab's sessionStorage).
